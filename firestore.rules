rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }
    match /doubts/{doubtId} {
      allow create: if signedIn() && request.resource.data.juniorId == request.auth.uid;
      allow read: if signedIn() && (resource.data.juniorId == request.auth.uid || resource.data.seniorId == request.auth.uid);
      allow update: if signedIn() && (resource.data.juniorId == request.auth.uid || request.resource.data.seniorId == request.auth.uid);
    }
    match /requests/{requestId} {
      allow create: if signedIn() && request.resource.data.juniorId == request.auth.uid;
      allow read, update: if signedIn() && (resource.data.juniorId == request.auth.uid || resource.data.seniorId == request.auth.uid);
    }
    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && resource.data.recipientId == request.auth.uid;
    }
    match /messages/{messageId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if signedIn();
    }
  }
}
